[Desktop Entry]
Type=Application
Name=Rustcord
GenericName=Discord client
Comment=Fast native Discord client
Exec=rustcord-qt %u
Icon=rustcord
Terminal=false
Categories=Network;InstantMessaging;Chat;
MimeType=x-scheme-handler/discord;
StartupWMClass=rustcord
Actions=settings;

[Desktop Action settings]
Name=Settings
Exec=rustcord-qt --settings
